# ==============================================================================
# ReachInbox Full-Stack Email Job Scheduler — Environment Configuration
# ==============================================================================

# Application Environment Mode (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public

# ------------------------------------------------------------------------------
# Redis Configuration (BullMQ, Distributed Throttling & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# BullMQ Worker & Concurrency Configuration (AGENTS.md §7, §8)
# ------------------------------------------------------------------------------
# Number of simultaneous jobs processed per worker instance (never hardcode)
WORKER_CONCURRENCY=5
EMAIL_WORKER_CONCURRENCY=10
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAY_MS=5000
EMAIL_SCHEDULING_BATCH_SIZE=500

# ------------------------------------------------------------------------------
# Email Sending Throttling & Rate Limiting (AGENTS.md §9, §10)
# ------------------------------------------------------------------------------
# Minimum delay between email sends in milliseconds
MIN_EMAIL_DELAY_MS=2000

# Maximum emails sent globally across all workers per 1-hour rolling window
MAX_EMAILS_PER_HOUR=200

# Maximum emails sent per sender account per 1-hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# ------------------------------------------------------------------------------
# Ethereal Email SMTP Provider (AGENTS.md §3, Phase 3)
# ------------------------------------------------------------------------------
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASSWORD=

SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# ------------------------------------------------------------------------------
# Elasticsearch Configuration (AGENTS.md §16)
# ------------------------------------------------------------------------------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (AGENTS.md §13)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SESSION_SECRET=reachinbox_development_session_secret_change_in_production

# ------------------------------------------------------------------------------
# Slack OAuth 2.0 Integration (AGENTS.md §12)
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
