# ==========================================
# ReachInbox Email Scheduler Environment Configuration
# ==========================================

# Environment Mode (development | test | production)
NODE_ENV=development

# Backend API Configuration
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public

# Redis Configuration (BullMQ / Rate Limiting)
REDIS_URL=redis://localhost:6379

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000
