{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://reachinboxapi-production-4da4.up.railway.app/api/$1"
    },
    {
      "source": "/health(.*)",
      "destination": "https://reachinboxapi-production-4da4.up.railway.app/health$1"
    },
    {
      "source": "/admin/queues(.*)",
      "destination": "https://reachinboxapi-production-4da4.up.railway.app/admin/queues$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
