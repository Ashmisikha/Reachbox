{
  "name": "reachinbox-email-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade distributed email scheduling and queue management system",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,cyan\" \"npm run dev -w @reachinbox/api\" \"npm run dev -w @reachinbox/web\"",
    "dev:api": "npm run dev -w @reachinbox/api",
    "dev:web": "npm run dev -w @reachinbox/web",
    "build": "npm run build -w @reachinbox/shared && npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @reachinbox/shared",
    "build:api": "npm run build -w @reachinbox/api",
    "build:web": "npm run build -w @reachinbox/web",
    "test": "npm run test -w @reachinbox/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "npm run db:generate -w @reachinbox/api",
    "db:migrate": "npm run db:migrate -w @reachinbox/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @reachinbox/api",
    "db:studio": "npm run db:studio -w @reachinbox/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
